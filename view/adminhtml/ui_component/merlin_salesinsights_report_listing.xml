<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">merlin_salesinsights_report_listing.merlin_salesinsights_report_listing_data_source</item>
            <item name="deps" xsi:type="string">merlin_salesinsights_report_listing.merlin_salesinsights_report_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">report_columns</item>
    </argument>

    <dataSource name="merlin_salesinsights_report_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Merlin_SalesInsights::report</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="merlin_salesinsights_report_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <exportButton name="export_button"/>
    </listingToolbar>

    <columns name="report_columns">
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>

        <column name="period_type">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Period</label>
                <options>
                    <option name="daily" xsi:type="array">
                        <item name="label" xsi:type="string">Daily</item>
                        <item name="value" xsi:type="string">daily</item>
                    </option>
                    <option name="weekly" xsi:type="array">
                        <item name="label" xsi:type="string">Weekly</item>
                        <item name="value" xsi:type="string">weekly</item>
                    </option>
                    <option name="monthly" xsi:type="array">
                        <item name="label" xsi:type="string">Monthly</item>
                        <item name="value" xsi:type="string">monthly</item>
                    </option>
                </options>
            </settings>
        </column>

        <column name="period_start" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Period Start</label>
            </settings>
        </column>

        <column name="period_end" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Period End</label>
            </settings>
        </column>

        <column name="store_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Store ID</label>
            </settings>
        </column>

        <column name="manufacturer_label">
            <settings>
                <filter>text</filter>
                <label translate="true">Manufacturer</label>
            </settings>
        </column>

        <column name="attribute_set_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Attribute Set</label>
            </settings>
        </column>

        <column name="order_count">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Orders</label>
            </settings>
        </column>

        <column name="qty_ordered">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Qty Ordered</label>
            </settings>
        </column>

        <column name="base_row_total" class="Magento\Sales\Ui\Component\Listing\Column\Price">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Base Row Total</label>
            </settings>
        </column>

        <column name="base_discount_amount" class="Magento\Sales\Ui\Component\Listing\Column\Price">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Base Discount</label>
            </settings>
        </column>

        <column name="base_tax_amount" class="Magento\Sales\Ui\Component\Listing\Column\Price">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Base Tax</label>
            </settings>
        </column>

        <column name="base_row_total_incl_tax" class="Magento\Sales\Ui\Component\Listing\Column\Price">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Base Row Total Incl Tax</label>
            </settings>
        </column>

        <column name="base_net_sales" class="Magento\Sales\Ui\Component\Listing\Column\Price">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Base Net Sales</label>
            </settings>
        </column>
    </columns>
</listing>
